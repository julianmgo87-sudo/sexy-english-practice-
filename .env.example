# Todo es opcional. Sin estas variables la app funciona igual: la voz de ejemplo viene
# pregrabada (public/audio) y la calificación usa el reconocimiento de voz del navegador
# (Chrome / Safari / Edge).

# Con esta clave la calificación usa transcripción con IA y confianza por palabra (más
# precisa). También da voz a frases que aún no tengan audio pregrabado.
OPENAI_API_KEY=

# Opcional: modelos y voz de OpenAI (por defecto gpt-4o-mini-transcribe, gpt-4o-mini-tts, marin)
OPENAI_TRANSCRIBE_MODEL=
OPENAI_TTS_MODEL=
OPENAI_TTS_VOICE=

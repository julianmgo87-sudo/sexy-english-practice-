# Todo es opcional: sin estas variables la app funciona con la voz y el
# reconocimiento de voz del navegador (Chrome / Safari / Edge).

# Con esta clave se activa la voz femenina premium (OpenAI TTS) y una
# calificación de pronunciación más precisa (transcripción con confianza por palabra).
OPENAI_API_KEY=

# Opcional: voz de OpenAI (marin, shimmer, coral, nova, sage...). Por defecto: marin
OPENAI_TTS_VOICE=
# Opcional: modelos de OpenAI
OPENAI_TTS_MODEL=
OPENAI_TRANSCRIBE_MODEL=
